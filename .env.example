# ============================================================
# Northbridge Bank Onboarding System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values
# .env should be added to .gitignore (do not commit secrets)

# Spring Environment Profile
SPRING_PROFILES_ACTIVE=local

# ============================================================
# Camunda 8 SaaS Configuration (Zeebe)
# ============================================================
# Get these from your Camunda Console after signing up for free trial
# https://camunda.com/get-started/
CAMUNDA_CLUSTER_ID=84881dbf-3013-40a8-b7d9-13bb69d84383
CAMUNDA_REGION=sin-2
CAMUNDA_CLIENT_ID=jrVPbzY1rMf4yHOz-oi_ZTo_KO6Vkjqc
CAMUNDA_CLIENT_SECRET=resAKS.g7hHHy9xlt7MPWArH_CkL_6NMq2GFVxdk-tll.wU1jYMl1O_lZS~IP8Fv

# URL of the onboarding service where BPMN/Zeebe client is hosted (application-service will call this)
ONBOARDING_SERVICE_URL=http://localhost:8083

# Enable auto-deploy of BPMN resources from onboarding-service classpath (default false)
PROCESS_DEPLOYER_ENABLED=false

# ============================================================
# MongoDB Atlas Configuration
# ============================================================
# Sign up for free tier at https://www.mongodb.com/cloud/atlas
# Format: mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_ATLAS_URI=mongodb://sanketdhake33_db_user:root1@ac-zyg8vrh-shard-00-00.awdffnm.mongodb.net:27017,ac-zyg8vrh-shard-00-01.awdffnm.mongodb.net:27017,ac-zyg8vrh-shard-00-02.awdffnm.mongodb.net:27017/?ssl=true&replicaSet=atlas-m6gzoo-shard-0&authSource=admin&appName=ClusterJobPortal

# ============================================================
# Auth Service Configuration
# ============================================================
# Generate a random secret (at least 32 characters) for JWT signing
AUTH_JWT_SECRET=<generate-a-random-long-secret-key-at-least-32-chars>
# Token expiration in seconds (3600 = 1 hour)
AUTH_JWT_EXPIRATION_SECONDS=3600

# ============================================================
# CORS Configuration
# ============================================================
# Comma-separated list of allowed origins for frontend
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# Local Kafka Configuration
# ============================================================
# These should remain as-is for local development
# Kafka will be running locally on your machine (KRaft mode, no Zookeeper)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ============================================================
# Service Ports
# ============================================================
# These are optional; services will use defaults if not set
SERVER_PORT_AUTH=8081
SERVER_PORT_APPLICATION=8082
SERVER_PORT_ONBOARDING=8083
SERVER_PORT_DOCUMENT=8084
SERVER_PORT_NOTIFICATION=8085
FRONTEND_PORT=3000
KAFKA_PORT=9092

