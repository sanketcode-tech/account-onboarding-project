    <bpmn:sequenceFlow id="Flow_0ztr1ys" sourceRef="Event_ApplicationSubmitted" targetRef="Task_ValidateApplication" />
    <bpmn:sequenceFlow id="Flow_1q6sog8" sourceRef="Task_ValidateApplication" targetRef="Activity_EvaluateEligibility" />
    <bpmn:sequenceFlow id="Flow_0ikyj1j" name="yes" sourceRef="Gateway_EligibilityApproved" targetRef="Task_PublishOffer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibilityResult.eligibilityStatus="APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14kii5w" sourceRef="Task_PublishOffer" targetRef="Task_SendOfferEmail" />
    <bpmn:sequenceFlow id="Flow_0jxrbef" sourceRef="Task_SendOfferEmail" targetRef="Gateway_OfferResponse" />
    <bpmn:sequenceFlow id="Flow_0d5ux9b" sourceRef="Gateway_OfferResponse" targetRef="Event_WaitOfferAccepted" />
    <bpmn:sequenceFlow id="Flow_0csqhn1" sourceRef="Gateway_OfferResponse" targetRef="Event_OfferTimeout" />
    <bpmn:sequenceFlow id="Flow_1yufbvf" sourceRef="Event_WaitOfferAccepted" targetRef="Task_PublishDocument" />
    <bpmn:sequenceFlow id="Flow_0m3jb2o" sourceRef="Task_PublishDocument" targetRef="Gateway_DocumentResponse" />
    <bpmn:sequenceFlow id="Flow_07h62qy" sourceRef="Gateway_DocumentResponse" targetRef="Event_WaitDocumentSigned" />
    <bpmn:sequenceFlow id="Flow_0nl12tw" sourceRef="Gateway_DocumentResponse" targetRef="Event_DocumentTimeout" />
    <bpmn:sequenceFlow id="Flow_13pi4jm" sourceRef="Event_WaitDocumentSigned" targetRef="Task_SigningCeremony" />
    <bpmn:sequenceFlow id="Flow_0t4xza4" sourceRef="Task_SigningCeremony" targetRef="Gateway_DocumentReviewed" />
    <bpmn:sequenceFlow id="Flow_0ntjzt7" name="yes" sourceRef="Gateway_DocumentReviewed" targetRef="Task_ProvisioningApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=signingDecision="APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1bfmf8h" sourceRef="Task_ProvisioningApproval" targetRef="Gateway_ProvisioningApproved" />
    <bpmn:sequenceFlow id="Flow_1yig9i0" name="yes" sourceRef="Gateway_ProvisioningApproved" targetRef="Task_ActivateAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=provisioningDecision="APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
