    <bpmn:sequenceFlow id="Flow_0dcopey" sourceRef="Task_PublishActivated" targetRef="Task_SendActivatedEmail" />
    <bpmn:sequenceFlow id="Flow_1spah2i" sourceRef="Gateway_DocumentReviewed" targetRef="Event_Declined" />
    <bpmn:sequenceFlow id="Flow_1e6eghd" sourceRef="Gateway_ProvisioningApproved" targetRef="Event_Declined" />
