        <bpmn:flowNodeRef>BoundaryEvent_ProvisioningTimeout</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_ActivationFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ExceptionHandling" name="Exception Handling">
        <bpmn:flowNodeRef>Activity_1vuhyuy</bpmn:flowNodeRef>
      </bpmn:lane>
