        <bpmn:flowNodeRef>Event_WaitDocumentSigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BoundaryEvent_ValidationFailed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ComplianceTeam" name="Phase 2: Review &#38; Activation">
        <bpmn:flowNodeRef>Task_SigningCeremony</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentReviewed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ProvisioningApproval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ProvisioningApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ActivateAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishActivated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendActivatedEmail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Success</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Declined</bpmn:flowNodeRef>
