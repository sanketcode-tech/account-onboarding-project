  <bpmn:process id="current-account-onboarding" name="Current Account Onboarding" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:laneSet id="LaneSet_0kuk3nc">
      <bpmn:lane id="Lane_System" name="Phase 1: Application &#38; Offer">
        <bpmn:flowNodeRef>Event_ApplicationSubmitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ValidateApplication</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishOffer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OfferResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_WaitOfferAccepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishDocument</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DocumentResponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_EvaluateEligibility</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EligibilityApproved</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOfferEmail</bpmn:flowNodeRef>
