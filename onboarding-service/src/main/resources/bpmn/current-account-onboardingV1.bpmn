    <bpmn:sequenceFlow id="Flow_1l1ba52" sourceRef="Event_DocumentTimeout" targetRef="Event_TriggerDeclined" />
    <bpmn:sequenceFlow id="Flow_01f6dk1" sourceRef="Event_OfferTimeout" targetRef="Event_TriggerDeclined" />
