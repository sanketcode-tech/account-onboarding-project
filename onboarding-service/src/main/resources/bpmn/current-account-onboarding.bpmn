      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_054g02o</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_ProvisioningTimeout">
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0t4xza4" sourceRef="Task_SigningCeremony" targetRef="Gateway_1avtep0" />
    <bpmn:serviceTask id="Task_ActivateAccount" name="Activate Bank Account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="activate-account" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yig9i0</bpmn:incoming>
      <bpmn:outgoing>Flow_1kdqb4h</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_ActivationFailed" name="Activation Failed" attachedToRef="Task_ActivateAccount">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;ACCOUNT_ACTIVATION_FAILED&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1ebnzc5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_ActivationFailed" errorRef="Error_ActivationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_PublishActivated" name="Publish Account Activated Event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-activated" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kdqb4h</bpmn:incoming>
      <bpmn:outgoing>Flow_0ldj9fk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1bfmf8h" sourceRef="Task_ProvisioningApproval" targetRef="Gateway_1dbkhuu" />
    <bpmn:sequenceFlow id="Flow_1kdqb4h" sourceRef="Task_ActivateAccount" targetRef="Task_PublishActivated" />
    <bpmn:endEvent id="Event_Success" name="Onboarding Complete">
      <bpmn:incoming>Flow_19j9xi1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0ldj9fk" sourceRef="Task_PublishActivated" targetRef="Task_SendActivatedEmail" />
    <bpmn:intermediateCatchEvent id="Event_OfferTimeout" name="Offer Expired (72h)">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;OFFER_EXPIRED&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0csqhn1</bpmn:incoming>
      <bpmn:outgoing>Flow_0atd9lm</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_OfferTimeout">
        <bpmn:timeDuration>PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_DocumentTimeout" name="Document Signing Expired (48h)">
