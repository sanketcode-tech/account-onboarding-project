        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="{{secrets.MAILTRAP_API_TOKEN}}" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://sandbox.api.mailtrap.io/api/send/4894420" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;&#10;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;&#10;  &#34;from&#34;: { &#34;email&#34;: &#34;onboarding@northbridge-demo.com&#34;, &#34;name&#34;: &#34;Northbridge Bank&#34; },&#10;&#10;  &#34;to&#34;: [ { &#34;email&#34;: email } ],&#10;&#10;  &#34;subject&#34;: &#34;Your Northbridge Current Account is Active!&#34;,&#10;&#10;  &#34;html&#34;: &#34;&#60;p&#62;Hi &#34; + applicantName + &#34;,&#60;/p&#62;&#60;p&#62;Great news — your account is now active.&#60;/p&#62;&#60;p&#62;Account ID: &#34; + accountId + &#34;&#60;br/&#62;Approved Limit: ₹&#34; + string(offeredLimit) + &#34;&#60;/p&#62;&#34;&#10;&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ldj9fk</bpmn:incoming>
      <bpmn:outgoing>Flow_19j9xi1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_19j9xi1" sourceRef="Task_SendActivatedEmail" targetRef="Event_Success" />
    <bpmn:serviceTask id="Task_SendOfferEmail" name="Send Offer Email" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="{{secrets.MAILTRAP_API_TOKEN}}" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://sandbox.api.mailtrap.io/api/send/4894420" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;  &#34;from&#34;: { &#34;email&#34;: &#34;onboarding@northbridge-demo.com&#34;, &#34;name&#34;: &#34;Northbridge Bank&#34; },&#10;  &#34;to&#34;: [ { &#34;email&#34;: email } ],&#10;  &#34;subject&#34;: &#34;Your Northbridge Current Account Offer is Ready&#34;,&#10;  &#34;html&#34;: &#34;&#60;p&#62;Hi &#34; + applicantName + &#34;,&#60;/p&#62;&#60;p&#62;Your offer of ₹&#34; + string(offeredLimit) + &#34; is ready (Offer ID: &#34; + offerId + &#34;). Log in to view and accept it.&#60;/p&#62;&#34;&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
