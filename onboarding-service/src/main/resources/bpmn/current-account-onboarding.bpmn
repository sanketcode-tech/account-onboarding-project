    <bpmn:sequenceFlow id="Flow_0csqhn1" sourceRef="Gateway_0ex282m" targetRef="Event_OfferTimeout" />
    <bpmn:sequenceFlow id="Flow_0nl12tw" sourceRef="Gateway_0xivmcz" targetRef="Event_DocumentTimeout" />
    <bpmn:serviceTask id="Task_PublishDeclined" name="Publish Application Declined Event">
