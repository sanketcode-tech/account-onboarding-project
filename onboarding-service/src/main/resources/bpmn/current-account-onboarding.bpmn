<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1avkhgv" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.48.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="current-account-onboarding" name="Current Account Onboarding" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="1.0" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Event_ApplicationSubmitted" name="Application Submitted">
      <bpmn:outgoing>Flow_0ztr1ys</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateApplication" name="Validate Application">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="validate-application" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ztr1ys</bpmn:incoming>
      <bpmn:outgoing>Flow_1q6sog8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_ValidationFailed" name="Validation Failed" attachedToRef="Task_ValidateApplication">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;VALIDATION_FAILED&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0tg9uf6</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_ValidationFailed" errorRef="Error_ValidationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0ztr1ys" sourceRef="Event_ApplicationSubmitted" targetRef="Task_ValidateApplication" />
    <bpmn:serviceTask id="Task_PublishOffer" name="Publish Offer Ready Event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-offer" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ikyj1j</bpmn:incoming>
      <bpmn:outgoing>Flow_14kii5w</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1q6sog8" sourceRef="Task_ValidateApplication" targetRef="Activity_EvaluateEligibility" />
    <bpmn:eventBasedGateway id="Gateway_0ex282m" name="Offer Response?">
      <bpmn:incoming>Flow_14kii5w</bpmn:incoming>
      <bpmn:outgoing>Flow_0d5ux9b</bpmn:outgoing>
      <bpmn:outgoing>Flow_0csqhn1</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_WaitOfferAccepted" name="Offer Accepted">
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="=applicationId" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0d5ux9b</bpmn:incoming>
      <bpmn:outgoing>Flow_1yufbvf</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_OfferAccepted" messageRef="Message_OfferAccepted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0d5ux9b" sourceRef="Gateway_0ex282m" targetRef="Event_WaitOfferAccepted" />
    <bpmn:serviceTask id="Task_PublishDocument" name="Publish Document Signing Request">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-document" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yufbvf</bpmn:incoming>
      <bpmn:outgoing>Flow_0m3jb2o</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1yufbvf" sourceRef="Event_WaitOfferAccepted" targetRef="Task_PublishDocument" />
    <bpmn:eventBasedGateway id="Gateway_0xivmcz" name="Document Response?">
      <bpmn:incoming>Flow_0m3jb2o</bpmn:incoming>
      <bpmn:outgoing>Flow_07h62qy</bpmn:outgoing>
      <bpmn:outgoing>Flow_0nl12tw</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_0m3jb2o" sourceRef="Task_PublishDocument" targetRef="Gateway_0xivmcz" />
    <bpmn:intermediateCatchEvent id="Event_WaitDocumentSigned" name="Document Signed">
      <bpmn:extensionElements>
        <zeebe:subscription correlationKey="=applicationId" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_07h62qy</bpmn:incoming>
      <bpmn:outgoing>Flow_13pi4jm</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDef_DocumentSigned" messageRef="Message_DocumentSigned" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_07h62qy" sourceRef="Gateway_0xivmcz" targetRef="Event_WaitDocumentSigned" />
    <bpmn:userTask id="Task_SigningCeremony" name="Offer Document Review">
      <bpmn:documentation>Review and approve the document signing ceremony</bpmn:documentation>
      <bpmn:extensionElements>
        <modeler:form key="signing-ceremony-form" />
        <zeebe:formDefinition formId="signing-ceremony-form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13pi4jm</bpmn:incoming>
      <bpmn:outgoing>Flow_0t4xza4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent_SigningCeremonyTimeout" name="Review Overdue (48h)" attachedToRef="Task_SigningCeremony">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;SIGNING_CEREMONY_TIMEOUT&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1dlwxmo</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_SigningCeremonyTimeout">
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_13pi4jm" sourceRef="Event_WaitDocumentSigned" targetRef="Task_SigningCeremony" />
    <bpmn:userTask id="Task_ProvisioningApproval" name="Provisioning Approval">
      <bpmn:documentation>Approve account provisioning and activation</bpmn:documentation>
      <bpmn:extensionElements>
        <modeler:form key="provisioning-approval-form" />
        <zeebe:formDefinition formId="provisioning-approval-form" />
        <zeebe:userTask />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0ntjzt7</bpmn:incoming>
      <bpmn:outgoing>Flow_1bfmf8h</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent_ProvisioningTimeout" name="Provisioning Approval Overdue (24h)" attachedToRef="Task_ProvisioningApproval">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;PROVISIONING_APPROVAL_TIMEOUT&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_054g02o</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_ProvisioningTimeout">
        <bpmn:timeDuration>PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_0t4xza4" sourceRef="Task_SigningCeremony" targetRef="Gateway_1avtep0" />
    <bpmn:serviceTask id="Task_ActivateAccount" name="Activate Bank Account">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="activate-account" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1yig9i0</bpmn:incoming>
      <bpmn:outgoing>Flow_1kdqb4h</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_ActivationFailed" name="Activation Failed" attachedToRef="Task_ActivateAccount">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;ACCOUNT_ACTIVATION_FAILED&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_1ebnzc5</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDef_ActivationFailed" errorRef="Error_ActivationFailed" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_PublishActivated" name="Publish Account Activated Event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-activated" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1kdqb4h</bpmn:incoming>
      <bpmn:outgoing>Flow_0dcopey</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1bfmf8h" sourceRef="Task_ProvisioningApproval" targetRef="Gateway_1dbkhuu" />
    <bpmn:sequenceFlow id="Flow_1kdqb4h" sourceRef="Task_ActivateAccount" targetRef="Task_PublishActivated" />
    <bpmn:endEvent id="Event_Success" name="Onboarding Complete">
      <bpmn:incoming>Flow_0dcopey</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_OfferTimeout" name="Offer Expired (72h)">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;OFFER_EXPIRED&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0csqhn1</bpmn:incoming>
      <bpmn:outgoing>Flow_0atd9lm</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_OfferTimeout">
        <bpmn:timeDuration>PT72H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_DocumentTimeout" name="Document Signing Expired (48h)">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=&#34;DOCUMENT_SIGNING_EXPIRED&#34;" target="declineReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0nl12tw</bpmn:incoming>
      <bpmn:outgoing>Flow_0wvldrk</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDef_DocumentTimeout">
        <bpmn:timeDuration>PT48H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0csqhn1" sourceRef="Gateway_0ex282m" targetRef="Event_OfferTimeout" />
    <bpmn:sequenceFlow id="Flow_0nl12tw" sourceRef="Gateway_0xivmcz" targetRef="Event_DocumentTimeout" />
    <bpmn:serviceTask id="Task_PublishDeclined" name="Publish Application Declined Event">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-declined" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0tg9uf6</bpmn:incoming>
      <bpmn:incoming>Flow_0atd9lm</bpmn:incoming>
      <bpmn:incoming>Flow_0wvldrk</bpmn:incoming>
      <bpmn:incoming>Flow_1dlwxmo</bpmn:incoming>
      <bpmn:incoming>Flow_054g02o</bpmn:incoming>
      <bpmn:incoming>Flow_1ebnzc5</bpmn:incoming>
      <bpmn:incoming>Flow_11jamru</bpmn:incoming>
      <bpmn:incoming>Flow_1bhw3zg</bpmn:incoming>
      <bpmn:incoming>Flow_16ksij9</bpmn:incoming>
      <bpmn:outgoing>Flow_1dlu23v</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_Declined" name="Application Declined">
      <bpmn:incoming>Flow_1dlu23v</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0tg9uf6" sourceRef="BoundaryEvent_ValidationFailed" targetRef="Task_PublishDeclined" />
    <bpmn:sequenceFlow id="Flow_0atd9lm" sourceRef="Event_OfferTimeout" targetRef="Task_PublishDeclined" />
    <bpmn:sequenceFlow id="Flow_0wvldrk" sourceRef="Event_DocumentTimeout" targetRef="Task_PublishDeclined" />
    <bpmn:sequenceFlow id="Flow_1dlwxmo" sourceRef="BoundaryEvent_SigningCeremonyTimeout" targetRef="Task_PublishDeclined" />
    <bpmn:sequenceFlow id="Flow_054g02o" sourceRef="BoundaryEvent_ProvisioningTimeout" targetRef="Task_PublishDeclined" />
    <bpmn:sequenceFlow id="Flow_1ebnzc5" sourceRef="BoundaryEvent_ActivationFailed" targetRef="Task_PublishDeclined" />
    <bpmn:exclusiveGateway id="Gateway_1avtep0" name="Document Reviewed?" default="Flow_11jamru">
      <bpmn:incoming>Flow_0t4xza4</bpmn:incoming>
      <bpmn:outgoing>Flow_0ntjzt7</bpmn:outgoing>
      <bpmn:outgoing>Flow_11jamru</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0ntjzt7" name="yes" sourceRef="Gateway_1avtep0" targetRef="Task_ProvisioningApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=signingDecision="APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11jamru" sourceRef="Gateway_1avtep0" targetRef="Task_PublishDeclined" />
    <bpmn:exclusiveGateway id="Gateway_1dbkhuu" name="Provisioning Approved?" default="Flow_1bhw3zg">
      <bpmn:incoming>Flow_1bfmf8h</bpmn:incoming>
      <bpmn:outgoing>Flow_1yig9i0</bpmn:outgoing>
      <bpmn:outgoing>Flow_1bhw3zg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1yig9i0" name="yes" sourceRef="Gateway_1dbkhuu" targetRef="Task_ActivateAccount">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=provisioningDecision="APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1bhw3zg" sourceRef="Gateway_1dbkhuu" targetRef="Task_PublishDeclined" />
    <bpmn:serviceTask id="Task_SendDeclineEmail" name="Send Decline Email" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="{{secrets.MAILTRAP_API_TOKEN}}" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://sandbox.api.mailtrap.io/api/send/4894420" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;&#10;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;&#10;  &#34;from&#34;: { &#34;email&#34;: &#34;onboarding@northbridge-demo.com&#34;, &#34;name&#34;: &#34;Northbridge Bank&#34; },&#10;&#10;  &#34;to&#34;: [ { &#34;email&#34;: email } ],&#10;&#10;  &#34;subject&#34;: &#34;Update on Your Northbridge Account Application&#34;,&#10;&#10;  &#34;html&#34;: &#34;&#60;p&#62;Hi &#34; + applicantName + &#34;,&#60;/p&#62;&#60;p&#62;We&#39;re unable to proceed with your application at this time. Reason: &#34; + declineReason + &#34;&#60;/p&#62;&#34;&#10;&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendActivatedEmail" name="Send Activated Email" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="{{secrets.MAILTRAP_API_TOKEN}}" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://sandbox.api.mailtrap.io/api/send/4894420" target="url" />
          <zeebe:input source="={&#34;Content-Type&#34;: &#34;application/json&#34;&#10;}" target="headers" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;&#10;  &#34;from&#34;: { &#34;email&#34;: &#34;onboarding@northbridge-demo.com&#34;, &#34;name&#34;: &#34;Northbridge Bank&#34; },&#10;&#10;  &#34;to&#34;: [ { &#34;email&#34;: email } ],&#10;&#10;  &#34;subject&#34;: &#34;Your Northbridge Current Account is Active!&#34;,&#10;&#10;  &#34;html&#34;: &#34;&#60;p&#62;Hi &#34; + applicantName + &#34;,&#60;/p&#62;&#60;p&#62;Great news — your account is now active.&#60;/p&#62;&#60;p&#62;Account ID: &#34; + accountId + &#34;&#60;br/&#62;Approved Limit: ₹&#34; + string(offeredLimit) + &#34;&#60;/p&#62;&#34;&#10;&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendOfferEmail" name="Send Offer Email" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="{{secrets.MAILTRAP_API_TOKEN}}" target="authentication.token" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://sandbox.api.mailtrap.io/api/send/4894420" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;  &#34;from&#34;: { &#34;email&#34;: &#34;onboarding@northbridge-demo.com&#34;, &#34;name&#34;: &#34;Northbridge Bank&#34; },&#10;  &#34;to&#34;: [ { &#34;email&#34;: email } ],&#10;  &#34;subject&#34;: &#34;Your Northbridge Current Account Offer is Ready&#34;,&#10;  &#34;html&#34;: &#34;&#60;p&#62;Hi &#34; + applicantName + &#34;,&#60;/p&#62;&#60;p&#62;Your offer of ₹&#34; + string(offeredLimit) + &#34; is ready (Offer ID: &#34; + offerId + &#34;). Log in to view and accept it.&#60;/p&#62;&#34;&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="Activity_EvaluateEligibility" name="Evaluate Eligibility">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="validateCurrentAccountApplication" resultVariable="eligibilityResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1q6sog8</bpmn:incoming>
      <bpmn:outgoing>Flow_0mxs77t</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_0mxs77t" sourceRef="Activity_EvaluateEligibility" targetRef="Gateway_07vg7tk" />
    <bpmn:exclusiveGateway id="Gateway_07vg7tk" name="Eligibility Approved?" default="Flow_16ksij9">
      <bpmn:incoming>Flow_0mxs77t</bpmn:incoming>
      <bpmn:outgoing>Flow_0ikyj1j</bpmn:outgoing>
      <bpmn:outgoing>Flow_16ksij9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0ikyj1j" name="yes" sourceRef="Gateway_07vg7tk" targetRef="Task_PublishOffer">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=eligibilityResult.eligibilityStatus="APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16ksij9" sourceRef="Gateway_07vg7tk" targetRef="Task_PublishDeclined" />
    <bpmn:sequenceFlow id="Flow_14kii5w" sourceRef="Task_PublishOffer" targetRef="Gateway_0ex282m" />
    <bpmn:sequenceFlow id="Flow_0dcopey" sourceRef="Task_PublishActivated" targetRef="Event_Success" />
    <bpmn:sequenceFlow id="Flow_1dlu23v" sourceRef="Task_PublishDeclined" targetRef="Event_Declined" />
  </bpmn:process>
  <bpmn:error id="Error_ValidationFailed" name="ValidationFailed" errorCode="VALIDATION_FAILED" />
  <bpmn:message id="Message_OfferAccepted" name="OfferAccepted">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:message id="Message_DocumentSigned" name="DocumentSigned">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=applicationId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_ActivationFailed" name="ActivationFailed" errorCode="ACTIVATION_FAILED" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="current-account-onboarding">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="Event_ApplicationSubmitted">
        <dc:Bounds x="182" y="212" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="173" y="255" width="54" height="27" />
        </bpmndi:BPMNLabel>
